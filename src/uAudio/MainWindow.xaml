<Window x:Class="uAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:uAudio"
        Title="uAudio"
        Width="1280"
        Height="720"
        Background="#1E1E1E"
        AllowDrop="True"
        DragEnter="MainWindow_DragOver"
        DragOver="MainWindow_DragOver"
        DragLeave="MainWindow_DragLeave"
        Drop="MainWindow_Drop"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:MainWindow.ImportAudioCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.SaveAs}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportMixCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{x:Static local:MainWindow.AddTrackCommand}"/>
        <KeyBinding Key="Space" Command="{x:Static local:MainWindow.PlayPauseCommand}"/>
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.StopPlaybackCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{x:Static local:MainWindow.CutSelectionCommand}"/>
        <KeyBinding Key="X" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.TrimSelectionCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.ShowShortcutsCommand}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" CanExecute="CommandBinding_CanExecute" Executed="NewCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" CanExecute="CommandBinding_CanExecute" Executed="OpenCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ImportAudioCommand}" CanExecute="CommandBinding_CanExecute" Executed="ImportAudioCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" CanExecute="CommandBinding_CanExecute" Executed="SaveCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" CanExecute="CommandBinding_CanExecute" Executed="SaveAsCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" CanExecute="CommandBinding_CanExecute" Executed="UndoCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ExportMixCommand}" CanExecute="CommandBinding_CanExecute" Executed="ExportMixCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.AddTrackCommand}" CanExecute="CommandBinding_CanExecute" Executed="AddTrackCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.PlayPauseCommand}" CanExecute="CommandBinding_CanExecute" Executed="PlayPauseCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.StopPlaybackCommand}" CanExecute="CommandBinding_CanExecute" Executed="StopPlaybackCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ZoomInCommand}" CanExecute="CommandBinding_CanExecute" Executed="ZoomInCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ZoomOutCommand}" CanExecute="CommandBinding_CanExecute" Executed="ZoomOutCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ResetZoomCommand}" CanExecute="CommandBinding_CanExecute" Executed="ResetZoomCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.CutSelectionCommand}" CanExecute="CommandBinding_CanExecute" Executed="CutSelectionCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.TrimSelectionCommand}" CanExecute="CommandBinding_CanExecute" Executed="TrimSelectionCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShowShortcutsCommand}" CanExecute="CommandBinding_CanExecute" Executed="ShowShortcutsCommand_Executed"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D30" Padding="6">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="New"
                        Margin="4,0"
                        Background="#444444"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static ApplicationCommands.New}"/>

                <Button Content="Open"
                        Margin="4,0"
                        Background="#444444"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        ToolTip="Ctrl+O — открыть проект или аудиофайлы"
                        Command="{x:Static ApplicationCommands.Open}"/>

                <Button Content="Import Audio"
                        Margin="4,0"
                        Background="#2E6B3E"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        ToolTip="Ctrl+I — импортировать один или несколько аудиофайлов"
                        Command="{x:Static local:MainWindow.ImportAudioCommand}"/>

                <Button Content="Save"
                        Margin="4,0"
                        Background="#2E5E88"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static ApplicationCommands.Save}"/>

                <Button Content="Save As"
                        Margin="4,0"
                        Background="#555555"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static ApplicationCommands.SaveAs}"/>

                <Button Content="Export WAV"
                        Margin="4,0"
                        Background="#7A5A22"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static local:MainWindow.ExportMixCommand}"/>

                <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>

                <Button x:Name="AddTrackButton"
                        Content="Add Track"
                        Margin="4,0"
                        Background="#335533"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static local:MainWindow.AddTrackCommand}"/>

                <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>

                <Button x:Name="PlayButton"
                        Content="Play"
                        Margin="4,0"
                        Background="#335577"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Click="PlayButton_Click"/>
                <Button x:Name="PauseButton"
                        Content="Pause"
                        Margin="4,0"
                        Background="#555533"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Click="PauseButton_Click"/>
                <Button x:Name="StopButton"
                        Content="Stop"
                        Margin="4,0"
                        Background="#553333"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Click="StopButton_Click"/>

                <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>

                <TextBlock Text="Zoom:"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           Margin="4,0"/>
                <Slider x:Name="ZoomSlider"
                        Width="150"
                        Minimum="10"
                        Maximum="500"
                        Value="100"
                        VerticalAlignment="Center"
                        TickFrequency="10"
                        IsSnapToTickEnabled="False"
                        ValueChanged="ZoomSlider_ValueChanged"/>
                <TextBlock x:Name="ZoomValueText"
                           Text="100 px/s"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="4,0"/>

                <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>

                <CheckBox x:Name="EditAllTracksCheckBox"
                          Content="Edit All Tracks"
                          Foreground="#CCCCCC"
                          VerticalAlignment="Center"
                          Margin="4,0"
                          FontSize="11"
                          Checked="EditAllTracksCheckBox_Changed"
                          Unchecked="EditAllTracksCheckBox_Changed"/>

                <Border Width="1" Height="20" Background="#555555" Margin="8,0"/>

                <Button x:Name="UndoButton"
                        Content="Undo"
                        Margin="4,0"
                        Background="#444466"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        Command="{x:Static ApplicationCommands.Undo}"/>

                <Button x:Name="ShortcutsButton"
                        Content="Keys"
                        Margin="4,0"
                        Background="#444444"
                        Foreground="White"
                        Padding="10,4"
                        FontSize="12"
                        ToolTip="F1 — shortcuts / горячие клавиши"
                        Command="{x:Static local:MainWindow.ShowShortcutsCommand}"/>

                <TextBlock x:Name="ProjectPathText"
                           Text="Untitled project"
                           Foreground="#AAAAAA"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <TextBlock x:Name="AutosaveStatusText"
                           Text="Autosave idle"
                           Foreground="#7FBF7F"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <TextBlock x:Name="TimeDisplay"
                           Text="00:00.000"
                           Foreground="#00FF00"
                           FontFamily="Consolas"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Background="#252528" Height="30">
            <ScrollViewer x:Name="RulerScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <Canvas x:Name="RulerCanvas"
                        Height="30"
                        Background="#252528"
                        MouseLeftButtonDown="RulerCanvas_MouseLeftButtonDown"/>
            </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="TimelineScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      AllowDrop="True"
                      ScrollChanged="TimelineScrollViewer_ScrollChanged">
            <Grid x:Name="TimelineGrid" Background="Transparent" AllowDrop="True">
                <StackPanel x:Name="TracksPanel" Orientation="Vertical"/>

                <Border x:Name="EmptyDropHintBorder"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="200,40,0,0"
                        Padding="20,14"
                        CornerRadius="6"
                        Background="#25252B"
                        BorderBrush="#444452"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Перетащите аудиофайлы из Проводника прямо сюда"
                                   Foreground="#DDDDDD"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="или нажмите «Import Audio» / «Open» / «Add Track»"
                                   Foreground="#999999"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False">
                    <Line x:Name="PlayheadLine"
                          X1="160"
                          Y1="0"
                          X2="160"
                          Y2="2000"
                          Stroke="Red"
                          StrokeThickness="2"
                          IsHitTestVisible="False"/>
                </Canvas>

                <Border x:Name="DragDropOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="#661A3A5C"
                        BorderBrush="#66B2FF"
                        BorderThickness="2"
                        Margin="4"
                        CornerRadius="6">
                    <TextBlock Text="Отпустите файлы для импорта в проект"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
