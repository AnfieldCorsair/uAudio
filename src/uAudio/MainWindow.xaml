<Window x:Class="uAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="uAudio Editor Pro" Height="600" Width="1000" Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Тулбар -->
            <RowDefinition Height="30"/>
            <!-- Линейка времени -->
            <RowDefinition Height="*"/>
            <!-- Треки -->
            <RowDefinition Height="30"/>
            <!-- Статус -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <StackPanel Orientation="Horizontal" Background="#252526" Grid.Row="0">
            <Button x:Name="BtnAddTrack" Content="+ Add Track" Width="100" Margin="10" Background="#3E3E42" Foreground="White" Click="BtnAddTrack_Click"/>
            <Line Y1="10" Y2="50" Stroke="#555" Margin="5,0"/>
            <Button x:Name="BtnPlay" Content="▶ Play" Width="80" Margin="5,10" Background="#1E4E1E" Foreground="White" Click="BtnPlay_Click"/>
            <Button x:Name="BtnStop" Content="⏹ Stop" Width="80" Margin="5,10" Background="#4E1E1E" Foreground="White" Click="BtnStop_Click"/>
            <Line Y1="10" Y2="50" Stroke="#555" Margin="5,0"/>
            <Button x:Name="BtnExport" Content="💾 Export WAV" Width="100" Margin="10" Background="#007ACC" Foreground="White" Click="BtnExport_Click"/>
            <TextBlock x:Name="TxtGlobalTimer" Text="00:00.000" Foreground="White" VerticalAlignment="Center" FontSize="20" Margin="20,0,0,0" FontFamily="Consolas"/>
        </StackPanel>

        <!-- RULER & TRACKS AREA (SCROLLABLE) -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <!-- Место под шкалу -->
                    <RowDefinition Height="*"/>
                    <!-- Место под треки -->
                </Grid.RowDefinitions>

                <!-- Чтобы треки не наезжали на левую панель, нам нужно знать ширину левой панели (150px) -->
                <!-- Но проще сделать так: ТрекRowControl сам делит пространство. -->
                <!-- Здесь мы просто накидываем треки один за другим -->

                <StackPanel x:Name="TracksContainer" Grid.Row="1" MinWidth="2000"/>
                <!-- MinWidth чтобы был скролл -->

                <!-- ГЛАВНЫЙ КУРСОР -->
                <!-- Он должен быть поверх всего. ZIndex решает. -->
                <!-- Но он должен скроллиться вместе с треками! Поэтому он внутри ScrollViewer -->
                <Canvas Grid.Row="1" Panel.ZIndex="999" IsHitTestVisible="False">
                    <!-- Line сдвинут на 150px вправо, потому что у нас слева панель управления в каждом треке -->
                    <Line x:Name="PlayheadLine" 
                          X1="150" Y1="0" 
                          X2="150" Y2="2000" 
                          Stroke="Red" StrokeThickness="1.5"/>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#007ACC">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" VerticalAlignment="Center" Margin="10,0"/>
        </Border>
    </Grid>
</Window>