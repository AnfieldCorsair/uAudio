<Window x:Class="uAudio.Controls.AudioImportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт аудиофайлов / Import Audio Files"
        Width="680"
        MinWidth="560"
        MinHeight="240"
        MaxHeight="720"
        SizeToContent="Height"
        Background="#1E1E1E"
        Foreground="#EEEEEE"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   Text="Выберите, куда добавить аудиофайлы:"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="#28282C"
                BorderBrush="#44444A"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <RadioButton x:Name="SameTargetRadio"
                             Content="Добавить все файлы в одну дорожку (последовательно)"
                             Foreground="#EEEEEE"
                             FontSize="13"
                             IsChecked="True"
                             Margin="0,0,0,8"
                             Checked="ModeRadio_Checked"/>

                <StackPanel x:Name="SingleTargetSelectorPanel"
                            Orientation="Horizontal"
                            Margin="24,0,0,10">
                    <TextBlock Text="Целевая дорожка:"
                               Foreground="#BBBBBB"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="SingleTargetComboBox"
                              Width="280"
                              FontSize="12"
                              SelectionChanged="SingleTargetComboBox_SelectionChanged"/>
                </StackPanel>

                <RadioButton x:Name="SeparateNewTracksRadio"
                             Content="Создать отдельную новую дорожку для каждого выбранного звука"
                             Foreground="#EEEEEE"
                             FontSize="13"
                             Margin="0,0,0,8"
                             Checked="ModeRadio_Checked"/>

                <RadioButton x:Name="PerFileCustomRadio"
                             Content="Настроить дорожку индивидуально для каждого файла"
                             Foreground="#EEEEEE"
                             FontSize="13"
                             Checked="ModeRadio_Checked"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <CheckBox x:Name="PlaceAtDropPositionCheckBox"
                      Content="Разместить начиная с позиции курсора/перетаскивания на таймлайне"
                      Foreground="#CCCCCC"
                      FontSize="12"
                      Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="PerFileListBorder"
                Grid.Row="3"
                Background="#252528"
                BorderBrush="#44444A"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                MaxHeight="280"
                Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FileAssignmentsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="#EEEEEE"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}"/>
                                    <TextBlock Text="{Binding DurationLabel}"
                                               Foreground="#999999"
                                               FontSize="10"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="→"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding AvailableTargets}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsCustomEnabled}"
                                          FontSize="12"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="100"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Background="#444444"
                    Foreground="White"
                    BorderBrush="#666666"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Content="Добавить"
                    Width="120"
                    Padding="10,6"
                    Background="#2E6B3E"
                    Foreground="White"
                    BorderBrush="#499B5E"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
