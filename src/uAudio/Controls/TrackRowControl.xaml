<UserControl x:Class="uAudio.Controls.TrackRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="120"
             MinHeight="80"
             AllowDrop="True"
             PreviewDragEnter="TrackRowControl_PreviewDragOver"
             PreviewDragOver="TrackRowControl_PreviewDragOver"
             PreviewDragLeave="TrackRowControl_PreviewDragLeave"
             PreviewDrop="TrackRowControl_PreviewDrop">
    <Border x:Name="RootBorder" BorderBrush="#555555" BorderThickness="0,0,0,1" Background="#1E1E1E">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2D2D30" BorderBrush="#555555" BorderThickness="0,0,1,0">
                <StackPanel Margin="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackNameText"
                               Text="Track"
                               Foreground="#DDDDDD"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Vol:"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,4,0"/>
                        <Slider x:Name="VolumeSlider"
                                Width="80"
                                Minimum="0"
                                Maximum="1.0"
                                Value="1.0"
                                VerticalAlignment="Center"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValueText"
                                   Text="100%"
                                   Foreground="#AAAAAA"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="MuteCheckBox"
                                  Content="Mute"
                                  Foreground="#CCCCCC"
                                  FontSize="11"
                                  Margin="0,0,10,0"
                                  Checked="MuteCheckBox_Changed"
                                  Unchecked="MuteCheckBox_Changed"/>
                        <Button x:Name="DeleteTrackButton"
                                Content="✕ Del"
                                FontSize="10"
                                Background="#662222"
                                Foreground="White"
                                BorderBrush="#884444"
                                Padding="6,2"
                                Click="DeleteTrackButton_Click"/>
                    </StackPanel>

                    <Button x:Name="AddFileButton"
                            Content="+ Add File(s)"
                            FontSize="10"
                            Background="#225522"
                            Foreground="White"
                            BorderBrush="#448844"
                            Padding="6,2"
                            Margin="0,4,0,0"
                            Click="AddFileButton_Click"/>
                </StackPanel>
            </Border>

            <Canvas x:Name="ClipCanvas"
                    Grid.Column="1"
                    Background="#1A1A2E"
                    ClipToBounds="True"
                    MouseRightButtonDown="ClipCanvas_MouseRightButtonDown"
                    MouseRightButtonUp="ClipCanvas_MouseRightButtonUp"
                    MouseMove="ClipCanvas_MouseMove"/>
        </Grid>
    </Border>
</UserControl>